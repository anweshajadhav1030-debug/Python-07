# 1. Create tuple and perform basic operations
t = (1, 2, 3, 4, 5, 6)
m = ("height", "length", "breadth", "radius")

print("Tuple 1:", t)
print("Tuple 2:", m)

print("Length of Tuple 1:", len(t))

print("Concatenation operation:", t + m)
print("Repetition operation on Tuple 2:", m * 2)

if 2 in t:
    print("2 is present in Tuple 1.")


# 2. Indexing, negative indexing, slicing, iteration
b = (9, 5, 7, 3, 45)

print(b)

print(b[3])      # indexing
print(b[-2:])    # negative indexing
print(b[1:4])    # slicing

print("Iteration:")
for i in b:
    print(i)


# 3. Tuples are immutable and deletion
a = (2, 5, 2, 7, 2, 8)

print(a)

# a[3] = 10  # ❌ Not allowed (tuple is immutable)

del a
print("Tuple deleted successfully")


# 4. Built-in functions
c = (0, 9, 8, 7, 6, 5, 4, 3, 2, 1)

print("Tuple:", c)

l = [5, 3, 8, 5, 9, 2, 8]

print("List:", l)

print("Maximum in Tuple:", max(c))
print("Minimum in Tuple:", min(c))
print("Length of Tuple:", len(c))

print("List converted to Tuple:", tuple(l))
